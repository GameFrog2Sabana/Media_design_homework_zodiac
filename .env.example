# ------------------------------------------------------------------
# Storage (optional)
# If omitted, local development writes .data/*.jsonl and Vercel skips
# storage entirely. Use a Neon Postgres connection string in production.
# ------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------
# Constellation generation (optional)
# Use either LLM_API_KEY or GEMINI_API_KEY. Without a key, the app
# returns the local poetic fallback generator and everything still works.
# Gemini 3 models use the Interactions API. Set LLM_API_STYLE=openai
# only when you point LLM_BASE_URL at an OpenAI-compatible server.
# ------------------------------------------------------------------
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_STYLE=gemini
